<UserControl x:Class="LocalFlow.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Button Content="Назад"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    MinWidth="82"
                    MinHeight="32"
                    Padding="12,6"
                    Margin="0,0,0,16" />
            <TextBlock Text="LocalFlow"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="Отправка файла на устройство в локальной сети"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <DockPanel Margin="0,0,0,7">
                <TextBlock Text="Сервер в сети"
                           Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Content="Обновить"
                        Command="{Binding RefreshServersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        MinHeight="32"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right" />
            </DockPanel>
            <ComboBox ItemsSource="{Binding Servers}"
                      SelectedItem="{Binding SelectedServer}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding IsIdle}"
                      Margin="0,0,0,16" />
            <TextBlock Text="Или адрес вручную"
                       Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsIdle}"
                     Margin="0,0,0,18" />
            <TextBlock Text="Файл"
                       Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,7">
                <Button DockPanel.Dock="Right"
                        Content="Обзор"
                        Command="{Binding BrowseFileCommand}"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="82"
                        MinHeight="34"
                        Padding="12,6"
                        Margin="8,0,0,0" />
                <TextBox Text="{Binding FilePath}"
                         IsReadOnly="True"
                         IsEnabled="{Binding IsIdle}" />
            </DockPanel>
            <TextBlock Text="Можно перетащить файл в это окно."
                       Style="{StaticResource SecondaryText}"
                       FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal">
            <Button Content="Отправить"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource PrimaryButton}" />
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DangerButton}"
                    Margin="0" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    VerticalAlignment="Bottom">
            <ProgressBar Height="4"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress}"
                         Foreground="#374151"
                         Background="#E5E7EB"
                         BorderThickness="0" />
            <TextBlock Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Foreground="#374151"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
