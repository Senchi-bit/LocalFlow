<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalFlowAvalonia.ViewModels"
        x:Class="LocalFlowAvalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding Title}"
        Height="560"
        Width="560"
        MinHeight="440"
        MinWidth="480"
        Background="#F8F9FA"
        FontSize="14"
        DragDrop.AllowDrop="True">
    <ContentControl Content="{Binding CurrentView}"
                    Margin="28" />
</Window>
