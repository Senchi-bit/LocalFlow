<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFlowAvalonia.ViewModels"
             x:Class="LocalFlowAvalonia.Views.ReceiveView"
             x:DataType="vm:ReceiveViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Button Content="Назад"
                    Command="{Binding BackCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Left"
                    MinWidth="82"
                    MinHeight="32"
                    Padding="12,6"
                    Margin="0,0,0,16" />
            <TextBlock Text="LocalFlow"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="Приём файлов с устройств в локальной сети"
                       Classes="secondary"
                       Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding ListenStatus}"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding MdnsStatus}"
                       Classes="secondary"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock Text="Папка входящих"
                       Classes="fieldLabel"
                       Margin="0,16,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Открыть папку"
                        Command="{Binding OpenInboxCommand}"
                        Classes="secondary"
                        MinWidth="118"
                        MinHeight="34"
                        Padding="12,6"
                        Margin="8,0,0,0" />
                <TextBox Text="{Binding InboxPath, Mode=OneWay}"
                         IsReadOnly="True" />
            </DockPanel>
        </StackPanel>
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top"
                       Text="Входящие передачи"
                       Classes="fieldLabel" />
            <ListBox ItemsSource="{Binding Transfers}"
                     BorderBrush="#E5E7EB"
                     BorderThickness="1"
                     Background="#FFFFFF"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:IncomingTransferItem">
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}"
                                       Classes="secondary"
                                       FontSize="12"
                                       Margin="0,3,0,8" />
                            <ProgressBar Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Progress}"
                                         Foreground="#374151"
                                         Background="#E5E7EB" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#374151"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
